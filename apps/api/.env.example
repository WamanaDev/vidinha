# Ver specs/infra/environments.md e specs/infra/secrets-management.md para detalhes.
# NUNCA preencher este arquivo com valores reais — apenas apps/api/.env (git-ignored).

NODE_ENV=development
DATABASE_URL=
DIRECT_URL=
SUPABASE_URL=
SUPABASE_JWKS_URL=
SUPABASE_SERVICE_ROLE_KEY=
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
PLUGGY_WEBHOOK_SECRET=
SENTRY_DSN_BACKEND=
LOG_LEVEL=debug
# Deixe em branco (unset) para usar o padrão seguro por ambiente: introspection
# desabilitada quando NODE_ENV=production, habilitada nos demais ambientes.
# Só defina explicitamente se souber o que está fazendo.
CORS_ALLOWED_ORIGINS=
GRAPHQL_INTROSPECTION_ENABLED=
